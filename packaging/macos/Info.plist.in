<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: packaging/macos/package.sh (release) and `cargo xtask bundle` (development)
     substitute @VERSION@ (full, e.g. 0.2.0-rc.1), @SHORT_VERSION@ (numeric X.Y.Z) and @BUILD_SHA@. -->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleDisplayName</key>
  <string>Roidery</string>
  <key>CFBundleName</key>
  <string>Roidery</string>
  <key>CFBundleExecutable</key>
  <string>Roidery</string>
  <key>CFBundleIdentifier</key>
  <string>app.roidery.Roidery</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleSignature</key>
  <string>????</string>
  <key>CFBundleShortVersionString</key>
  <string>@SHORT_VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@SHORT_VERSION@</string>
  <key>RoideryVersion</key>
  <string>@VERSION@</string>
  <key>RoideryBuildCommit</key>
  <string>@BUILD_SHA@</string>
  <key>CFBundleIconFile</key>
  <string>Roidery</string>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.graphics-design</string>
  <!-- Must match MACOSX_DEPLOYMENT_TARGET in package.sh. Big Sur is the first release on
       Apple silicon and has the Metal feature set wgpu targets. -->
  <key>LSMinimumSystemVersion</key>
  <string>11.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSSupportsAutomaticGraphicsSwitching</key>
  <true/>
  <key>NSRequiresAquaSystemAppearance</key>
  <false/>
  <key>NSHumanReadableCopyright</key>
  <string>Copyright © the Roidery authors and the VectorCraft authors. MIT OR Apache-2.0.</string>

  <!-- Every format File › Open reads (OPEN_EXTS in crates/engine/src/cmd/fileio/mod.rs; a test in
       apps/vectorcraft checks this list), so Finder offers Roidery for them (Open With,
       double-click, Dock drop). Roidery owns its native formats (VectorCraft's document and
       template formats, which it saves); for the others it is an alternate, so it doesn't take over another app's files. The app isn't NSDocument-based (no
       NSDocumentClass): it opens these files itself (apps/vectorcraft/src/open_documents.rs). -->
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key><string>VectorCraft Document</string>
      <key>LSItemContentTypes</key><array><string>ai.storyteller.vectorcraft.document</string></array>
      <key>CFBundleTypeRole</key><string>Editor</string>
      <key>LSHandlerRank</key><string>Owner</string>
    </dict>
    <dict>
      <key>CFBundleTypeName</key><string>VectorCraft Template</string>
      <key>CFBundleTypeExtensions</key><array><string>vctemplate</string></array>
      <key>CFBundleTypeRole</key><string>Editor</string>
      <key>LSHandlerRank</key><string>Owner</string>
    </dict>
    <dict>
      <key>CFBundleTypeName</key><string>SVG</string>
      <key>CFBundleTypeExtensions</key><array><string>svg</string><string>svgz</string></array>
      <key>CFBundleTypeRole</key><string>Editor</string>
      <key>LSHandlerRank</key><string>Alternate</string>
    </dict>
    <dict>
      <key>CFBundleTypeName</key><string>PDF</string>
      <key>CFBundleTypeExtensions</key><array><string>pdf</string></array>
      <key>CFBundleTypeRole</key><string>Editor</string>
      <key>LSHandlerRank</key><string>Alternate</string>
    </dict>
    <dict>
      <key>CFBundleTypeName</key><string>PDF-compatible .ai</string>
      <key>CFBundleTypeExtensions</key><array><string>ai</string><string>ait</string></array>
      <key>CFBundleTypeRole</key><string>Editor</string>
      <key>LSHandlerRank</key><string>Alternate</string>
    </dict>
    <dict>
      <key>CFBundleTypeName</key><string>Embroidery Machine File</string>
      <key>CFBundleTypeExtensions</key><array><string>dst</string><string>pes</string><string>jef</string><string>exp</string><string>vp3</string><string>xxx</string><string>u01</string><string>tap</string><string>dsb</string><string>dsz</string><string>hus</string></array>
      <key>CFBundleTypeRole</key><string>Editor</string>
      <key>LSHandlerRank</key><string>Alternate</string>
    </dict>
    <dict>
      <key>CFBundleTypeName</key><string>EPS</string>
      <key>CFBundleTypeExtensions</key><array><string>eps</string></array>
      <key>CFBundleTypeRole</key><string>Editor</string>
      <key>LSHandlerRank</key><string>Alternate</string>
    </dict>
    <dict>
      <key>CFBundleTypeName</key><string>DXF</string>
      <key>CFBundleTypeExtensions</key><array><string>dxf</string></array>
      <key>CFBundleTypeRole</key><string>Editor</string>
      <key>LSHandlerRank</key><string>Alternate</string>
    </dict>
    <dict>
      <key>CFBundleTypeName</key><string>EMF and WMF</string>
      <key>CFBundleTypeExtensions</key><array><string>emf</string><string>wmf</string></array>
      <key>CFBundleTypeRole</key><string>Editor</string>
      <key>LSHandlerRank</key><string>Alternate</string>
    </dict>
    <dict>
      <key>CFBundleTypeName</key><string>Image</string>
      <key>CFBundleTypeExtensions</key>
      <array>
        <string>png</string><string>jpg</string><string>jpeg</string><string>gif</string>
        <string>webp</string><string>tif</string><string>tiff</string><string>bmp</string>
      </array>
      <key>CFBundleTypeRole</key><string>Editor</string>
      <key>LSHandlerRank</key><string>Alternate</string>
    </dict>
  </array>

  <!-- The native document format, VectorCraft's (.drawcraft is its name from before VectorCraft's
       rename). Its type identifier and name stay VectorCraft's: the format is shared with it. -->
  <key>UTExportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>ai.storyteller.vectorcraft.document</string>
      <key>UTTypeDescription</key>
      <string>VectorCraft Document</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.data</string>
        <string>public.image</string>
      </array>
      <key>UTTypeIconFile</key>
      <string>Roidery</string>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array><string>vectorcraft</string><string>drawcraft</string></array>
        <key>public.mime-type</key>
        <array><string>application/x-vectorcraft</string></array>
      </dict>
    </dict>
  </array>
</dict>
</plist>
